# Dynamic Pro ERP — production-safe environment template
# NEVER commit real secrets. Provision them through your secret manager / CI.

# Runtime mode: development | test | production
DYNAMICPRO_ENV=production

# Master PostgreSQL
DB_USER=dynamicpro
DB_PASSWORD=<REQUIRED_SECRET>
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=dynamicpro

# Flask / application signing key (32+ random bytes recommended)
SECRET_KEY=<REQUIRED_SECRET>

# Required for multi-worker production rate limiting
RATELIMIT_STORAGE_URI=redis://redis:6379/0

# Browser origins allowed to use credentialed CORS APIs
CORS_ORIGINS=https://erp.example.com

# One-time cloud bootstrap administrator password (14+ characters).
# Prefer injecting it only during initial provisioning and removing it afterwards.
# DYNAMICPRO_BOOTSTRAP_ADMIN_PASSWORD=<REQUIRED_ONE_TIME_SECRET>

# Optional tenant/company instance selector
# COMPANY_ID=
# COMPANY_PORT=

# Optional master security controls
# MASTER_2FA_REQUIRED=true
# MASTER_SESSION_TTL_HOURS=8
# MASTER_MAX_LOGIN_ATTEMPTS=5
# TOTP_ISSUER=DynamicPro-ERP

# Optional AI providers (prefer a managed secret store in production)
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# Logging
# LOG_LEVEL=INFO
# LOG_DIR=logs
