# ─────────────────────────────────────────────────────────────
# DynamicPro ERP — ERP Control Center
# ملف متغيرات البيئة النموذجي (ENV EXAMPLE)
#
# انسخه إلى `.env` ثم عدّل القيم حسب بيئتك. لا ترفع `.env` إلى Git أبداً.
# الحساسات الحقيقية لا تُكتب هنا ولا في الكود؛ تُقرأ من متغيرات البيئة
# أو من ملفات محلية مستثناة (.db_password، .secret_key*، instance/).
# ─────────────────────────────────────────────────────────────

# ── وضع التشغيل ─────────────────────────────────────────────
# development | production | testing
APP_ENV=development

# في وضع الإنتاج مع HTTPS مفعّل تُرسَل الكوكي عبر HTTPS فقط
DYNAMICPRO_MODE=development

# ── قاعدة البيانات الرئيسية (Master DB) ─────────────────────
DB_USER=mokawlat_user
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=dynamicpro
# كلمة المرور تُقرأ من .db_password تلقائياً أو من هذا المتغير.
# اتركها فارغة إن كنت تعتمد على ملف .db_password المحلي.
# DB_PASSWORD=

# ── جلسة الشركة (اختياري — تُستخدم وقت تشغيل نسخة شركة) ─────
# COMPANY_ID=
# COMPANY_PORT=
# SECRET_KEY=

# ── أمان المدير (Control Center — Phase 1) ──────────────────
# سيكون JWT/TOTP/Brute-force إعدادات المرحلة التالية (توثيق مبكر فقط)
# JWT_SECRET_KEY=
# TOTP_ISSUER=DynamicPro-ERP
# MASTER_2FA_REQUIRED=false
# MASTER_SESSION_TTL_HOURS=8
# MASTER_MAX_LOGIN_ATTEMPTS=5

# ── البنية التحتية (اختياري) ────────────────────────────────
# LOG_LEVEL=INFO
# LOG_DIR=logs
# MASTER_DB_URL=postgresql://mokawlat_user:CHANGEME@127.0.0.1:5432/dynamicpro
